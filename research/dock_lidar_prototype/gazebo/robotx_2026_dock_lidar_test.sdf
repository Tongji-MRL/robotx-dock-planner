<?xml version="1.0"?>
<sdf version="1.9">
  <world name="robotx_2026_dock_lidar_test">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <scene>
      <ambient>0.8 0.8 0.8</ambient>
      <background>0.2 0.3 0.4</background>
    </scene>

    <include>
      <uri>model://robotx_2026_task3_dock</uri>
      <name>competition_dock</name>
    </include>

    <!-- Static LiDAR, 6 m in front of the entrance plane. -->
    <model name="test_lidar">
      <static>true</static>
      <pose>-6 0 1.2 0 0 0</pose>
      <link name="lidar_link">
        <sensor name="dock_lidar" type="gpu_lidar">
          <topic>/robotx_2026_dock_lidar/scan</topic>
          <update_rate>5</update_rate>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>1440</samples><resolution>1</resolution>
                <min_angle>-1.57079632679</min_angle>
                <max_angle>1.57079632679</max_angle>
              </horizontal>
              <vertical>
                <samples>32</samples><resolution>1</resolution>
                <min_angle>-0.3490658504</min_angle>
                <max_angle>0.0872664626</max_angle>
              </vertical>
            </scan>
            <range><min>0.3</min><max>25.0</max><resolution>0.01</resolution></range>
            <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
          </lidar>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
