Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.45
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 100; 100; 100
      Enabled: true
      Name: Water plane
      Plane: XY
      Reference Frame: <Fixed Frame>
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 1
        Min Value: -1
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 80; 210; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: Synthetic Mid-360 cloud
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.035
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /task3/sim/livox/lidar
      Use Fixed Frame: true
      Use rainbow: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Search and detections
      Namespaces:
        bay_labels: true
        bay_observation: true
        detected_coarse: true
        detected_entrances: true
        geofence: true
        search_lines: true
        search_stations: true
        usv: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /task3/sim/markers
  Enabled: true
  Global Options:
    Background Color: 25; 30; 38
    Fixed Frame: livox_frame
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 32
      Focal Point:
        X: 7
        Y: 0
        Z: 0
      Name: Task3 overview
      Near Clip Distance: 0.01
      Pitch: 0.72
      Target Frame: <Fixed Frame>
      Yaw: 0.80
Window Geometry:
  Height: 850
  Width: 1350
  X: 80
  Y: 50
